{
  "name": "knowledge-base",
  "version": "1.0.0",
  "description": "",
  "main": "index.js",
  "scripts": {
    "dev": "bun run tools/build-search-index.ts && astro dev",
    "build": "bun run tools/build-search-index.ts && astro build",
    "preview": "astro preview",
    "qa:lighthouse": "node --experimental-strip-types tools/lighthouse-task6.ts",
    "typecheck": "tsc --noEmit",
    "lint": "biome check --vcs-enabled=true --vcs-client-kind=git --vcs-use-ignore-file=true . && markdownlint-cli2 \"**/*.md\" \"#node_modules\"",
    "test": "pnpm exec vitest run",
    "ci": "pnpm run typecheck && pnpm run lint && pnpm run test && pnpm run build && pnpm exec playwright test"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "engines": {
    "node": ">=24.0.0"
  },
  "devEngines": {
    "packageManager": {
      "name": "pnpm",
      "version": "^11.13.0",
      "onFail": "download"
    }
  },
  "type": "module",
  "dependencies": {
    "astro": "^7.0.9",
    "ky": "2.0.2",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.12.1",
    "@biomejs/biome": "^2.5.3",
    "@playwright/test": "^1.61.1",
    "@types/node": "24.13.3",
    "lighthouse": "^13.4.0",
    "markdownlint-cli2": "^0.23.0",
    "puppeteer-core": "^25.3.0",
    "typescript": "^7.0.2",
    "vitest": "^4.1.10"
  }
}
